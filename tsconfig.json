{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* src/ is browser-only code; without this, @types/node (needed only for
       vite.config.ts) ambiently augments global TypedArrays here too, which
       breaks strict BufferSource typing on Web Crypto calls. Triple-slash
       references (vite/client, vite-plugin-pwa/react in vite-env.d.ts) are
       unaffected by this and keep working. */
    "types": [],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,

    /* Strictness — deliberately stricter than the blueprint's `strict: false` */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "packages/*/src", "packages/*/test"]
}
